# Dependencies
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build outputs
lib/
dist/
*.tsbuildinfo

# Ennio prebuilt dylibs — produced by CI on tag push, shipped in the npm
# tarball, never committed. Local devs run packages/ennio/scripts/build-shim.sh
# + packages/ennio/scripts/build-dylib.sh to regenerate; manifest.json is
# refreshed by scripts/regen-manifest.sh.
packages/ennio/prebuilt/*.dylib
packages/ennio/prebuilt/manifest.json

# Ennio Android injection — build artifacts. The agent dex is regenerated as a
# C byte-array header and the JVMTI agent .so is compiled by
# packages/ennio/android-inject/scripts/build-android.sh. The CLI pushes the
# .so to the device and attaches it with `am attach-agent` (nothing is bundled
# into the target APK), so these never need committing.
packages/ennio/android-inject/native/agent_dex.h
/tmp/ennio-android/

drivers
reports

# Nitro generated
packages/nitro/nitrogen/generated/

# iOS
*.xcworkspace
*.xcuserdata
Pods/
DerivedData/

# Stale root-level prebuild output. The active Expo projects live under
# examples/, so /ios and /android at repo root are vestigial. Anchor
# with a leading slash so examples/*/ios stays tracked.
/ios/
/android/

