 import {createServer as createHTTPServer} from 'node:http'
+import net from 'node:net'
 import {parse} from 'node:url'
 
 import {createServer, type TestPDS} from './test-pds.ts'
 
+// ---- L4 proxy on the app-facing :3000 ----
+// The e2e app build talks to a hardcoded http://localhost:3000. Real PDS
+// instances bind dynamic ports now, so a STANDBY instance can pre-warm in
+// the background while the live one is still serving; each request swaps
+// the proxy target instead of paying the ~2.8s TestNetwork spin-up inline.
+let currentPdsPort = 0
+net
+  .createServer(sock => {
+    const target = currentPdsPort
+    if (!target) return sock.destroy()
+    const up = net.connect(target, '127.0.0.1')
+    sock.pipe(up)
+    up.pipe(sock)
+    const kill = () => {
+      sock.destroy()
+      up.destroy()
+    }
+    sock.on('error', kill)
+    up.on('error', kill)
+  })
+  .listen(3000)
+
+// Monotonically advancing base ports: a retiring instance's teardown
+// (docker postgres schema drop) can outlive the next pre-warm, so a port
+// can NOT be reused generation-to-generation — every instance gets a
+// fresh +100 window (pds at base, plc/bsky scan upward from it).
+let nextPdsBase = 3000
+function makeServer(inviteRequired: boolean): Promise<TestPDS> {
+  nextPdsBase += 100
+  if (nextPdsBase > 9900) nextPdsBase = 3100
+  return createServer({inviteRequired, pdsPort: nextPdsBase})
+}
