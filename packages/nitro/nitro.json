{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["tasto"],
  "ios": {
    "iosModuleName": "TastoNitro"
  },
  "android": {
    "androidNamespace": ["tasto"],
    "androidCxxLibName": "TastoNitro"
  },
  "autolinking": {
    "Tasto": {
      "ios": {
        "language": "c++",
        "implementationClassName": "HybridTasto"
      },
      "android": {
        "language": "c++",
        "implementationClassName": "HybridTasto"
      }
    }
  },
  "ignorePaths": ["node_modules"]
}
