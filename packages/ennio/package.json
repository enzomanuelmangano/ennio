{
  "name": "@reactiive/ennio",
  "version": "0.0.9-beta.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/enzomanuelmangano/ennio.git",
    "directory": "packages/ennio"
  },
  "main": "lib/index.js",
  "dependencies": {
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "bin": {
    "ennio": "./dist/cli.js"
  },
  "description": "Maestro-compatible E2E test runner for React Native iOS. In-process ObjC dylib + Unix-socket protocol, no XCTest, no CDP.",
  "files": [
    "lib/",
    "dist/",
    "src/index.ts",
    "cpp/",
    "ios/bootstrap/",
    "ios/finders/",
    "ios/handlers/",
    "ios/observers/",
    "ios/ops/",
    "ios/PrivateAPI/",
    "EnnioCore.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "prebuilt/",
    "scripts/build-shim.sh",
    "scripts/build-dylib.sh",
    "scripts/regen-manifest.sh",
    "native-shim/",
    "ios/hid/",
    "native-hid/helper/",
    "scripts/build-hid-helper.sh"
  ],
  "keywords": [
    "react-native",
    "e2e",
    "testing",
    "maestro",
    "ios"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "tsc",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --external:fsevents",
    "build": "npm run build:lib && npm run build:cli && chmod +x dist/cli.js",
    "clean": "rm -rf lib dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node dist/cli.js test ../../example/maestro-e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "types": "lib/index.d.ts"
}
